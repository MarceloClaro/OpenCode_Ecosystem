  "mcp": {
    "filesystem": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/mnt/c/Users/marce"
      ]
    },
    "code-runner": {
      "type": "local",
      "enabled": false,
      "command": [
        "mcp-server-code-runner"
      ]
    },
    "mcp-python-interpreter": {
      "type": "local",
      "enabled": false,
      "command": [
        "mcp-python-interpreter"
      ]
    },
    "sqlite": {
      "type": "local",
      "enabled": false,
      "command": [
        "mcp-server-sqlite"
      ]
    },
    "sequential-thinking": {
      "type": "local",
      "enabled": true,
      "command": [
        "node",
        "C:/Users/marce/AppData/Roaming/npm/node_modules/@modelcontextprotocol/server-sequential-thinking/dist/index.js"
      ]
    },
    "websearch": {
      "type": "local",
      "enabled": true,
