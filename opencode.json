          "name": "deepseek-ai/deepseek-r1",
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "deepseek-ai/deepseek-v3": {
