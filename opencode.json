{
  "$schema": "https://opencode.ai/config.json",
  "model": "nvidia/deepseek-ai/deepseek-r1",
  "small_model": "nvidia/deepseek-ai/deepseek-v3",
  "default_agent": "marceloclaro",
  "instructions": [
    "AGENTS.md"
  ],
  "autoupdate": true,
  "compaction": {
    "auto": true,
    "tail_turns": 15,
    "reserved": 10000
